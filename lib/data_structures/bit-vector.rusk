/// 同じ長さのビット列に論理演算を適用します。
extern fn __bitor__<N: Int>(a: Bits<N>, b: Bits<N>) -> Bits<N> {
    code: "Obj<@{Bits<N>}> @{fn}(Obj<@{Bits<N>}> a,Obj<@{Bits<N>}> b,[[maybe_unused]] Loc loc){if(a->length!=b->length)fail(loc,\"bit length mismatch\");auto r=make_obj<@{Bits<N>}>(*a);for(std::size_t i=0;i<r->words.size();++i)r->words[i]=a->words[i]|b->words[i];return r;}",
    effects: "checked_read_fresh",
}

/// 同じ長さのビット列に論理演算を適用します。
extern fn __bitxor__<N: Int>(a: Bits<N>, b: Bits<N>) -> Bits<N> {
    code: "Obj<@{Bits<N>}> @{fn}(Obj<@{Bits<N>}> a,Obj<@{Bits<N>}> b,[[maybe_unused]] Loc loc){if(a->length!=b->length)fail(loc,\"bit length mismatch\");auto r=make_obj<@{Bits<N>}>(*a);for(std::size_t i=0;i<r->words.size();++i)r->words[i]=a->words[i]^b->words[i];return r;}",
    effects: "checked_read_fresh",
}

/// 長さを保って全ビットを反転します。
extern fn __bitnot__<N: Int>(a: Bits<N>) -> Bits<N> {
    code: "Obj<@{Bits<N>}> @{fn}(Obj<@{Bits<N>}> a,[[maybe_unused]] Loc loc){auto r=make_obj<@{Bits<N>}>(*a);for(auto& w:r->words)w=~w;r->trim();return r;}",
    effects: "read_fresh",
}

/// ゼロを詰めてシフトします。負の量は逆方向で、長さは変えません。
extern fn __shl__<N: Int>(a: Bits<N>, n: Int) -> Bits<N> {
    depends: "__runtime_extended_sequences__",
    code: "Obj<@{Bits<N>}> @{fn}(Obj<@{Bits<N>}> a,Obj<@{Int}> n,[[maybe_unused]] Loc loc){return make_obj<@{Bits<N>}>(@{Bits<N>}(RuskBitVec::shift(*a,*n,true,loc)));}",
    effects: "checked_read_fresh",
}

/// ゼロを詰めてシフトします。負の量は逆方向で、長さは変えません。
extern fn __shr__<N: Int>(a: Bits<N>, n: Int) -> Bits<N> {
    depends: "__runtime_extended_sequences__",
    code: "Obj<@{Bits<N>}> @{fn}(Obj<@{Bits<N>}> a,Obj<@{Int}> n,[[maybe_unused]] Loc loc){return make_obj<@{Bits<N>}>(@{Bits<N>}(RuskBitVec::shift(*a,*n,false,loc)));}",
    effects: "checked_read_fresh",
}

/// 長さと全ビットからハッシュを計算します。
extern fn __hash__<N: Int>(a: Bits<N>) -> Int {
    code: "Obj<@{Int}> @{fn}(Obj<@{Bits<N>}> a,[[maybe_unused]] Loc loc){std::size_t h=a->length;for(auto w:a->words)rusk_hash_combine(h,std::hash<std::uint64_t>{}(w));return make_obj<std::int64_t>(static_cast<std::int64_t>(h));}",
    effects: "read_fresh",
}

/// 所有元を保持し、構造変更を検出する走査状態です。
extern type<N: Int> BitsIter<N> {
    depends: "__runtime_extended_sequences__",
    cpp_name: "RuskLinearIter<@{Bits<N>}>",
    representation: "iterator<Bool>",
    retains: "owner:Bits<N>",
}

/// 所有元を共有する新しい走査状態を作ります。
extern fn __iter__<N: Int>(a: Bits<N>) -> BitsIter<N> {
    code: "Obj<@{BitsIter<N>}> @{fn}(Obj<@{Bits<N>}> a,[[maybe_unused]] Loc loc){return make_obj<@{BitsIter<N>}>(@{BitsIter<N>}(a));}",
    effects: "read_fresh",
    aliases: "return.owner=0",
}

/// 現在の走査状態を共有します。
extern fn __iter__<N: Int>(it: BitsIter<N>) -> BitsIter<N> {
    code: "Obj<@{BitsIter<N>}> @{fn}(Obj<@{BitsIter<N>}> it,[[maybe_unused]] Loc loc){return it;}",
    effects: "read_fresh",
    aliases: "return=0",
}

/// 次の要素があるか調べます。走査中の構造変更は失敗します。
extern fn __iter_has_next__<N: Int>(it: BitsIter<N>) -> Bool {
    depends: "__runtime_lazy_iterators__",
    code: "Obj<@{Bool}> @{fn}(Obj<@{BitsIter<N>}> it,[[maybe_unused]] Loc loc){if(it->finished)return make_obj<bool>(false);rusk_guard_iter(it,loc);if(it->index>=it->owner->size()){it->finished=true;return make_obj<bool>(false);}return make_obj<bool>(true);}",
}

/// 次の要素を返して位置を進めます。終了後の取得は失敗します。
extern fn __iter_next__<N: Int>(it: BitsIter<N>) -> Bool {
    depends: "__runtime_lazy_iterators__",
    code: "Obj<@{Bool}> @{fn}(Obj<@{BitsIter<N>}> it,[[maybe_unused]] Loc loc){if(it->finished)fail(loc,\"iterator exhausted\");rusk_guard_iter(it,loc);if(it->index>=it->owner->size()){it->finished=true;fail(loc,\"iterator exhausted\");}return make_obj<bool>(it->owner->at(it->index++));}",
}

/// 位置をコピーし、所有元を共有する走査状態を返します。
extern fn __copy__<N: Int>(it: BitsIter<N>) -> BitsIter<N> {
    depends: "__runtime_lazy_iterators__",
    code: "Obj<@{BitsIter<N>}> @{fn}(Obj<@{BitsIter<N>}> it,[[maybe_unused]] Loc loc){rusk_guard_iter(it,loc);return make_obj<@{BitsIter<N>}>(*it);}",
    effects: "checked_read_fresh",
    aliases: "return.owner=0.owner",
}

/// 外側の同一性を保ち、走査位置と所有元を更新します。
extern fn __assign__<N: Int>(a: BitsIter<N>, b: BitsIter<N>) -> Unit {
    depends: "__runtime_lazy_iterators__",
    code: "void @{fn}(Obj<@{BitsIter<N>}> a,Obj<@{BitsIter<N>}> b,[[maybe_unused]] Loc loc){rusk_guard_iter(b,loc);auto value=*b;*a=std::move(value);}",
}
