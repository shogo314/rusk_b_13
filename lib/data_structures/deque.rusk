/// 両端から定数時間で追加・取り出しできる両端キューです。
extern type<T> Deque {
    depends: "__runtime_extended_sequences__",
    cpp_name: "RuskDeque<{T}>",
    representation: "vector<T>",
}

/// 空の両端キューを作ります。
extern fn Deque<T>() -> Deque<T> {
    code: "Obj<@{Deque<T>}> @{fn}([[maybe_unused]] Loc loc){return make_obj<@{Deque<T>}>(@{Deque<T>}{});}",
    effects: "read_fresh",
}

/// 配列の各要素をコピーして構築します。
extern fn Deque<T>(a: Vec<T>) -> Deque<T> {
    code: "Obj<@{Deque<T>}> @{fn}(Obj<@{Vec<T>}> a,[[maybe_unused]] Loc loc){auto result=make_obj<@{Deque<T>}>(@{Deque<T>}{});const auto version=a->version;const auto n=a->size();auto guard=[&](){if(a->version!=version||a->size()!=n)fail(loc,\"container changed during copy\");};for(std::size_t i=0;i<n;++i){guard();{auto original=(*a)[i];result->values.push_back(@{boxed_call __copy__(T)->T}(original,loc));}guard();}return result;}",
    effects: "checked_read_fresh",
}

/// 各要素を__copy__でコピーし、独立した外側の配列を返します。
extern fn __copy__<T>(a: Deque<T>) -> Deque<T> {
    code: "Obj<@{Deque<T>}> @{fn}(Obj<@{Deque<T>}> a,[[maybe_unused]] Loc loc){auto r=make_obj<@{Deque<T>}>(@{Deque<T>}{});const auto version=a->version;const auto n=a->size();for(std::size_t i=0;i<n;++i){if(a->version!=version||a->size()!=n)fail(loc,\"container changed during copy\");{auto original=a->values[i];r->values.push_back(@{boxed_call __copy__(T)->T}(original,loc));}if(a->version!=version||a->size()!=n)fail(loc,\"container changed during copy\");}return r;}",
    effects: "checked_read_fresh",
}

/// 外側を保ってコピー代入します。解放中の再変更も検出します。
extern fn __assign__<T>(a: Deque<T>, b: Deque<T>) -> Unit {
    code: "void @{fn}(Obj<@{Deque<T>}> a,Obj<@{Deque<T>}> b,[[maybe_unused]] Loc loc){auto r=@{boxed_call __copy__(Deque<T>)->Deque<T>}(b,loc);if(r.use_count()>1)r=make_obj<@{Deque<T>}>(*r);a->values.swap(r->values);++a->version;auto version=a->version;r->values.clear();r.reset();if(a->version!=version)fail(loc,\"container changed during assignment\");}",
}

/// 要素数を返します。
extern fn len<T>(a: Deque<T>) -> Int {
    code: "Obj<@{Int}> @{fn}(Obj<@{Deque<T>}> a,[[maybe_unused]] Loc loc){return make_obj<std::int64_t>(checked_int(a->size(),loc));}",
    effects: "checked_read_fresh",
}

/// 空ならtrueです。
extern fn is_empty<T>(a: Deque<T>) -> Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{Deque<T>}> a,[[maybe_unused]] Loc loc){return make_obj<bool>(a->values.empty());}",
    effects: "read_fresh",
}

/// 要素を共有して返します。負の添字は末尾から数えます。
extern fn get<T>(a: Deque<T>, i: Int) -> T {
    return_abi: "object",
    code: "Obj<@{T}> @{fn}(Obj<@{Deque<T>}> a,Obj<@{Int}> i,[[maybe_unused]] Loc loc){return a->values[checked_index(a->size(),*i,loc)];}",
    effects: "element",
}

/// 要素を共有して返します。負の添字は末尾から数えます。
extern fn __getitem__<T>(a: Deque<T>, i: Int) -> T {
    return_abi: "object",
    code: "Obj<@{T}> @{fn}(Obj<@{Deque<T>}> a,Obj<@{Int}> i,[[maybe_unused]] Loc loc){return a->values[checked_index(a->size(),*i,loc)];}",
    effects: "element",
}

/// 指定位置の共有先を置き換えます。
extern fn __setitem__<T>(a: Deque<T>, i: Int, value: T) -> T {
    return_abi: "object",
    code: "Obj<@{T}> @{fn}(Obj<@{Deque<T>}> a,Obj<@{Int}> i,Obj<@{T}> value,[[maybe_unused]] Loc loc){auto index=checked_index(a->size(),*i,loc);auto displaced=std::move(a->values[index]);a->values[index]=value;displaced.reset();return value;}",
    effects: "replace_element",
}

/// 指定位置の値をコピーして更新します。
fn set<T>(a: Deque<T>, i: Int, value: T) {
    a[i] = value;
}

/// 要素を共有して先頭へ追加します。
extern fn push_front<T>(a: Deque<T>, value: T) -> Unit {
    code: "void @{fn}(Obj<@{Deque<T>}> a,Obj<@{T}> value,[[maybe_unused]] Loc loc){a->values.push_front(value);++a->version;}",
    effects: "resize_retain_second",
}

/// 先頭の要素を取り出して共有を返します。空なら失敗します。
extern fn pop_front<T>(a: Deque<T>) -> T {
    return_abi: "object",
    code: "Obj<@{T}> @{fn}(Obj<@{Deque<T>}> a,[[maybe_unused]] Loc loc){if(a->values.empty())fail(loc,\"empty deque\");auto value=std::move(a->values.front());a->values.pop_front();++a->version;return value;}",
    effects: "pop_element",
}

/// 先頭の要素を共有して返します。空なら失敗します。
extern fn front<T>(a: Deque<T>) -> T {
    return_abi: "object",
    code: "Obj<@{T}> @{fn}(Obj<@{Deque<T>}> a,[[maybe_unused]] Loc loc){if(a->values.empty())fail(loc,\"empty deque\");return a->values.front();}",
}

/// 要素を共有して末尾へ追加します。
extern fn push_back<T>(a: Deque<T>, value: T) -> Unit {
    code: "void @{fn}(Obj<@{Deque<T>}> a,Obj<@{T}> value,[[maybe_unused]] Loc loc){a->values.push_back(value);++a->version;}",
    effects: "resize_retain_second",
}

/// 末尾の要素を取り出して共有を返します。空なら失敗します。
extern fn pop_back<T>(a: Deque<T>) -> T {
    return_abi: "object",
    code: "Obj<@{T}> @{fn}(Obj<@{Deque<T>}> a,[[maybe_unused]] Loc loc){if(a->values.empty())fail(loc,\"empty deque\");auto value=std::move(a->values.back());a->values.pop_back();++a->version;return value;}",
    effects: "pop_element",
}

/// 末尾の要素を共有して返します。空なら失敗します。
extern fn back<T>(a: Deque<T>) -> T {
    return_abi: "object",
    code: "Obj<@{T}> @{fn}(Obj<@{Deque<T>}> a,[[maybe_unused]] Loc loc){if(a->values.empty())fail(loc,\"empty deque\");return a->values.back();}",
}

/// すべての要素への共有を手放します。
extern fn clear<T>(a: Deque<T>) -> Unit {
    code: "void @{fn}(Obj<@{Deque<T>}> a,[[maybe_unused]] Loc loc){decltype(a->values) displaced;a->values.swap(displaced);++a->version;}",
    effects: "checked_clear_first",
}

/// 所有元を保持し、構造変更を検出する走査状態です。
extern type<T> DequeIter<T> {
    depends: "__runtime_extended_sequences__",
    cpp_name: "RuskLinearIter<@{Deque<T>}>",
    representation: "iterator<T>",
    retains: "owner:Deque<T>",
}

/// 所有元を共有する新しい走査状態を作ります。
extern fn __iter__<T>(a: Deque<T>) -> DequeIter<T> {
    code: "Obj<@{DequeIter<T>}> @{fn}(Obj<@{Deque<T>}> a,[[maybe_unused]] Loc loc){return make_obj<@{DequeIter<T>}>(@{DequeIter<T>}(a));}",
    effects: "read_fresh",
    aliases: "return.owner=0",
}

/// 現在の走査状態を共有します。
extern fn __iter__<T>(it: DequeIter<T>) -> DequeIter<T> {
    code: "Obj<@{DequeIter<T>}> @{fn}(Obj<@{DequeIter<T>}> it,[[maybe_unused]] Loc loc){return it;}",
    effects: "read_fresh",
    aliases: "return=0",
}

/// 次の要素があるか調べます。走査中の構造変更は失敗します。
extern fn __iter_has_next__<T>(it: DequeIter<T>) -> Bool {
    depends: "__runtime_lazy_iterators__",
    code: "Obj<@{Bool}> @{fn}(Obj<@{DequeIter<T>}> it,[[maybe_unused]] Loc loc){if(it->finished)return make_obj<bool>(false);rusk_guard_iter(it,loc);if(it->index>=it->owner->size()){it->finished=true;return make_obj<bool>(false);}return make_obj<bool>(true);}",
}

/// 次の要素を返して位置を進めます。終了後の取得は失敗します。
extern fn __iter_next__<T>(it: DequeIter<T>) -> T {
    depends: "__runtime_lazy_iterators__",
    return_abi: "object",
    code: "Obj<@{T}> @{fn}(Obj<@{DequeIter<T>}> it,[[maybe_unused]] Loc loc){if(it->finished)fail(loc,\"iterator exhausted\");rusk_guard_iter(it,loc);if(it->index>=it->owner->size()){it->finished=true;fail(loc,\"iterator exhausted\");}return it->owner->at(it->index++);}",
}

/// 位置をコピーし、所有元を共有する走査状態を返します。
extern fn __copy__<T>(it: DequeIter<T>) -> DequeIter<T> {
    depends: "__runtime_lazy_iterators__",
    code: "Obj<@{DequeIter<T>}> @{fn}(Obj<@{DequeIter<T>}> it,[[maybe_unused]] Loc loc){rusk_guard_iter(it,loc);return make_obj<@{DequeIter<T>}>(*it);}",
    effects: "checked_read_fresh",
    aliases: "return.owner=0.owner",
}

/// 外側の同一性を保ち、走査位置と所有元を更新します。
extern fn __assign__<T>(a: DequeIter<T>, b: DequeIter<T>) -> Unit {
    depends: "__runtime_lazy_iterators__",
    code: "void @{fn}(Obj<@{DequeIter<T>}> a,Obj<@{DequeIter<T>}> b,[[maybe_unused]] Loc loc){rusk_guard_iter(b,loc);auto value=*b;*a=std::move(value);}",
}
