//! 全順序を持つキーの整列集合・重複集合・辞書です。
/// 型の全順序比較をネイティブの木へ接続する内部操作です。
fn __ordered_less__<K>(a: K, b: K) -> Bool {
    return __total_less__(a, b);
}

/// キー順に並ぶ集合です。キーの順序は格納中に変更しないでください。
extern type<K> OrderedSet {
    depends: "__runtime_ordered__",
    cpp_name: "RuskOrderedSet<{K},@{value_call __ordered_less__<K>(K,K)->Bool}>",
    representation: "set<K>",
}

/// 空の整列コンテナを作ります。
extern fn OrderedSet<K>() -> OrderedSet<K> {
    code: "Obj<@{OrderedSet<K>}> @{fn}([[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);return make_obj<@{OrderedSet<K>}>(@{OrderedSet<K>}{});}",
    effects: "read_fresh",
}

/// 要素数を返します。重複集合では重複も数えます。
extern fn len<K>(a: OrderedSet<K>) -> Int {
    code: "Obj<@{Int}> @{fn}(Obj<@{OrderedSet<K>}> a,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);return make_obj<std::int64_t>(checked_int(a->entries.size(),loc));}",
    effects: "checked_read_fresh",
}

/// 空ならtrueです。
extern fn is_empty<K>(a: OrderedSet<K>) -> Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{OrderedSet<K>}> a,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);return make_obj<bool>(a->entries.empty());}",
    effects: "read_fresh",
}

/// 同じ順序上のキーが存在するか調べます。
extern fn contains<K>(a: OrderedSet<K>, key: K) -> Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{OrderedSet<K>}> a,Obj<@{K}> key,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);[[maybe_unused]]auto less=@{value_call __ordered_less__<K>(K,K)->Bool};return make_obj<bool>(a->entries.find(key)!=a->entries.end());}",
    effects: "checked_read_fresh",
}

/// 順序上同じキーの個数を返します。
extern fn count<K>(a: OrderedSet<K>, key: K) -> Int {
    code: "Obj<@{Int}> @{fn}(Obj<@{OrderedSet<K>}> a,Obj<@{K}> key,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);[[maybe_unused]]auto less=@{value_call __ordered_less__<K>(K,K)->Bool};return make_obj<std::int64_t>(checked_int(a->entries.count(key),loc));}",
    effects: "checked_read_fresh",
}

/// 全要素を削除します。比較・解放処理から同じ木への再入は失敗します。
extern fn clear<K>(a: OrderedSet<K>) -> Unit {
    code: "void @{fn}(Obj<@{OrderedSet<K>}> a,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);if(!a->entries.empty()){a->entries.clear();++a->version;}}",
}

/// キーをコピーして追加します。集合は新規追加ならtrueを返します。
extern fn insert<K>(a: OrderedSet<K>, key: K) -> Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{OrderedSet<K>}> a,Obj<@{K}> key,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);[[maybe_unused]]auto less=@{value_call __ordered_less__<K>(K,K)->Bool};if(a->entries.find(key)!=a->entries.end())return make_obj<bool>(false);auto value=@{boxed_call __copy__(K)->K}(key,loc);auto result=a->entries.insert(value);if(result.second)++a->version;return make_obj<bool>(result.second);}",
    effects: "checked_mutate_fresh",
}

/// 該当するキーを1個削除し、削除できたか返します。
extern fn erase<K>(a: OrderedSet<K>, key: K) -> Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{OrderedSet<K>}> a,Obj<@{K}> key,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);auto p=a->entries.find(key);if(p==a->entries.end())return make_obj<bool>(false);a->entries.erase(p);++a->version;return make_obj<bool>(true);}",
}

/// 指定境界のキーのコピーをSomeで返します。不在ならNoneです。
extern fn lower_bound<K>(a: OrderedSet<K>, key: K) -> Option<K> {
    code: "Obj<@{Option<K>}> @{fn}(Obj<@{OrderedSet<K>}> a,Obj<@{K}> key,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);[[maybe_unused]]auto less=@{value_call __ordered_less__<K>(K,K)->Bool};auto p=a->entries.lower_bound(key);if(p==a->entries.end())return rusk_enum_make<@{Option<K>},1>();auto original=*p;auto value=@{boxed_call __copy__(K)->K}(original,loc);return rusk_enum_make<@{Option<K>},0>(value);}",
    effects: "checked_read_fresh",
}

/// 指定境界のキーのコピーをSomeで返します。不在ならNoneです。
extern fn upper_bound<K>(a: OrderedSet<K>, key: K) -> Option<K> {
    code: "Obj<@{Option<K>}> @{fn}(Obj<@{OrderedSet<K>}> a,Obj<@{K}> key,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);[[maybe_unused]]auto less=@{value_call __ordered_less__<K>(K,K)->Bool};auto p=a->entries.upper_bound(key);if(p==a->entries.end())return rusk_enum_make<@{Option<K>},1>();auto original=*p;auto value=@{boxed_call __copy__(K)->K}(original,loc);return rusk_enum_make<@{Option<K>},0>(value);}",
    effects: "checked_read_fresh",
}

/// 指定境界のキーのコピーをSomeで返します。不在ならNoneです。
extern fn first<K>(a: OrderedSet<K>) -> Option<K> {
    code: "Obj<@{Option<K>}> @{fn}(Obj<@{OrderedSet<K>}> a,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);[[maybe_unused]]auto less=@{value_call __ordered_less__<K>(K,K)->Bool};auto p=a->entries.begin();if(p==a->entries.end())return rusk_enum_make<@{Option<K>},1>();auto original=*p;auto value=@{boxed_call __copy__(K)->K}(original,loc);return rusk_enum_make<@{Option<K>},0>(value);}",
    effects: "checked_read_fresh",
}

/// 指定境界のキーのコピーをSomeで返します。不在ならNoneです。
extern fn last<K>(a: OrderedSet<K>) -> Option<K> {
    code: "Obj<@{Option<K>}> @{fn}(Obj<@{OrderedSet<K>}> a,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);[[maybe_unused]]auto less=@{value_call __ordered_less__<K>(K,K)->Bool};auto p=a->entries.end();if(p!=a->entries.begin())--p;if(p==a->entries.end())return rusk_enum_make<@{Option<K>},1>();auto original=*p;auto value=@{boxed_call __copy__(K)->K}(original,loc);return rusk_enum_make<@{Option<K>},0>(value);}",
    effects: "checked_read_fresh",
}

/// キーと値をそれぞれ__copy__でコピーします。
extern fn __copy__<K>(a: OrderedSet<K>) -> OrderedSet<K> {
    code: "Obj<@{OrderedSet<K>}> @{fn}(Obj<@{OrderedSet<K>}> a,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);[[maybe_unused]]auto less=@{value_call __ordered_less__<K>(K,K)->Bool};auto version=a->version;auto size=a->entries.size();auto guard=[&](){if(a->version!=version||a->entries.size()!=size)fail(loc,\"container changed during copy\");};auto r=make_obj<@{OrderedSet<K>}>(@{OrderedSet<K>}{});auto p=a->entries.begin();while(true){guard();if(p==a->entries.end())break;{auto original=*p;auto key=@{boxed_call __copy__(K)->K}(original,loc);guard();r->entries.insert(key);}guard();++p;}return r;}",
    effects: "checked_read_fresh",
}

/// 外側を保ってコピー代入します。解放中の再変更も検出します。
extern fn __assign__<K>(a: OrderedSet<K>, b: OrderedSet<K>) -> Unit {
    code: "void @{fn}(Obj<@{OrderedSet<K>}> a,Obj<@{OrderedSet<K>}> b,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);auto r=@{boxed_call __copy__(OrderedSet<K>)->OrderedSet<K>}(b,loc);if(r.use_count()>1)r=make_obj<@{OrderedSet<K>}>(*r);a->entries.swap(r->entries);++a->version;auto version=a->version;r->entries.clear();r.reset();if(a->version!=version)fail(loc,\"container changed during assignment\");}",
}

/// 昇順に走査し、構造変更と再入を検出する状態です。
extern type<K> OrderedSetIter {
    cpp_name: "RuskHashIterator<{OrderedSet<K>}>",
    representation: "iterator<K>",
    retains: "owner:OrderedSet<K>",
}

/// 昇順の走査状態を作ります。
extern fn __iter__<K>(a: OrderedSet<K>) -> OrderedSetIter<K> {
    code: "Obj<@{OrderedSetIter<K>}> @{fn}(Obj<@{OrderedSet<K>}> a,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);return make_obj<@{OrderedSetIter<K>}>(@{OrderedSetIter<K>}(a));}",
    effects: "read_fresh",
    aliases: "return.owner=0",
}

/// 現在の走査状態を共有します。
extern fn __iter__<K>(it: OrderedSetIter<K>) -> OrderedSetIter<K> {
    code: "Obj<@{OrderedSetIter<K>}> @{fn}(Obj<@{OrderedSetIter<K>}> it,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);return it;}",
    effects: "read_fresh",
    aliases: "return=0",
}

/// 次の要素があるか確認します。走査中の構造変更は失敗します。
extern fn __iter_has_next__<K>(it: OrderedSetIter<K>) -> Bool {
    depends: "__runtime_lazy_iterators__",
    code: "Obj<@{Bool}> @{fn}(Obj<@{OrderedSetIter<K>}> it,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);if(it->finished)return make_obj<bool>(false);rusk_guard_iter(it,loc);if(it->position==it->end){it->finished=true;return make_obj<bool>(false);}return make_obj<bool>(true);}",
}

/// キーをコピーして次の要素を返します。辞書の値は共有します。
extern fn __iter_next__<K>(it: OrderedSetIter<K>) -> K {
    depends: "__runtime_lazy_iterators__",
    code: "Obj<@{K}> @{fn}(Obj<@{OrderedSetIter<K>}> it,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);if(it->finished)fail(loc,\"iterator exhausted\");rusk_guard_iter(it,loc);if(it->position==it->end){it->finished=true;fail(loc,\"iterator exhausted\");}RuskHashAdvanceGuard advancing(it->advancing,loc);auto original=*it->position;auto key=@{boxed_call __copy__(K)->K}(original,loc);rusk_guard_iter(it,loc);++it->position;return key;}",
}

/// 位置を独立にコピーし、走査元を共有します。
extern fn __copy__<K>(it: OrderedSetIter<K>) -> OrderedSetIter<K> {
    depends: "__runtime_lazy_iterators__",
    code: "Obj<@{OrderedSetIter<K>}> @{fn}(Obj<@{OrderedSetIter<K>}> it,[[maybe_unused]] Loc loc){RuskHashLocation location_tracker(loc);rusk_guard_iter(it,loc);if(it->advancing)fail(loc,\"iterator reentered during key copy\");auto r=make_obj<@{OrderedSetIter<K>}>(@{OrderedSetIter<K>}(it->owner));r->finished=it->finished;if(!it->finished)r->position=it->position;return r;}",
    effects: "checked_read_fresh",
    aliases: "return.owner=0.owner",
}

/// 昇順のキーのコピーを配列で返します。
fn keys<K>(a: OrderedSet<K>) -> Vec<K> {
    let result: Vec<K> := [];
    for key in a {
        result.push_back(key);
    }
    return result;
}

