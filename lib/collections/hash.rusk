extern fn __assign__<K>(target: Set<K>, source: Set<K>) -> Unit {
    code: "void @{fn}(Obj<@{Set<K>}> target,Obj<@{Set<K>}> source,Loc loc){RuskHashLocation location_tracker(loc);auto snapshot=@{rooted_call __copy__(Set<K>)->Set<K>}(source,loc);if(snapshot.use_count()>1)snapshot=make_obj<@{Set<K>}>(*snapshot);target->entries.swap(snapshot->entries);++target->version;const auto version=target->version;const auto size=target->entries.size();auto guard=[&](){if(target->version!=version||target->entries.size()!=size)fail(loc,\"container changed during assignment\");};snapshot->entries.clear();guard();snapshot.reset();guard();}",
