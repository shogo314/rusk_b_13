/// 非負のInt指数で累乗します。0の0乗は1です。
extern fn __pow__(a: BigInt, n: Int) -> BigInt {
    depends: "__runtime_big_int__",
    code: "Obj<RuskBigInt> rusk_std_big_int_29(Obj<RuskBigInt> a,Obj<std::int64_t> n,[[maybe_unused]] Loc loc){if(*n<0)fail(loc,\"negative integer exponent\");auto result=RuskBigInt(1),base=*a;auto e=static_cast<std::uint64_t>(*n);while(e){if(e&1)result=result*base;e>>=1;if(e)base=base*base;}return make_obj<RuskBigInt>(std::move(result));}",
    cpp_name: "rusk_std_big_int_29",
    effects: "checked_read_fresh",
}

