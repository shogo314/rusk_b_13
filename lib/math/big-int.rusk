/// 全順序の比較結果を返します。
fn __cmp__(a: BigInt, b: BigInt) -> Ordering {
    return if a < b {
        Ordering::Less
    } else {
        if a > b {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    };
}
/// 絶対値の独立したコピーを返します。
fn abs(a: BigInt) -> BigInt {
    return if a < BigInt() {
        -a
    } else {
        copy(a)
    };
}
/// 2つのBigIntの最小値をコピーします。
fn min(a: BigInt, b: BigInt) -> BigInt {
    return if a < b {
        copy(a)
    } else {
        copy(b)
    };
}
/// 2つのBigIntの最大値をコピーします。
fn max(a: BigInt, b: BigInt) -> BigInt {
    return if a > b {
        copy(a)
    } else {
        copy(b)
    };
}

