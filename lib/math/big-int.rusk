//! 外部依存のない、符号付き任意精度整数です。

/// 符号付き任意精度整数。加減算は桁数に比例し、乗算・除算は初期の二次時間実装です。
extern type BigInt {
    depends: "__runtime_big_int__",
    cpp_name: "RuskBigInt",
}

/// 任意精度整数の0を作ります。
extern fn BigInt() -> BigInt {
    depends: "__runtime_big_int__",
    code: "Obj<RuskBigInt> rusk_std_big_int_1([[maybe_unused]] Loc loc){return make_obj<RuskBigInt>(RuskBigInt{});}",
    cpp_name: "rusk_std_big_int_1",
    effects: "read_fresh",
}

/// Intから独立したBigIntを作ります。
extern fn BigInt(x: Int) -> BigInt {
    depends: "__runtime_big_int__",
    code: "Obj<RuskBigInt> rusk_std_big_int_2(Obj<std::int64_t> x,[[maybe_unused]] Loc loc){return make_obj<RuskBigInt>(RuskBigInt(*x));}",
    cpp_name: "rusk_std_big_int_2",
    effects: "read_fresh",
}

